FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# 1. Install compiler toolchain and dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    curl \
    python3 \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# 2. Build zlib-ng (The modern C99 baseline in ZLIB_COMPAT mode)
RUN git clone --depth 1 https://github.com/zlib-ng/zlib-ng.git /workspace/zlib-ng && \
    cd /workspace/zlib-ng && \
    cmake -B build -DCMAKE_BUILD_TYPE=Release -DZLIB_COMPAT=ON -DZLIB_ENABLE_TESTS=OFF && \
    cmake --build build --config Release -j$(nproc)

# 3. Copy and build zlib-zero (Our C++20 engine)
COPY . /workspace/zlib-zero
RUN cd /workspace/zlib-zero && \
    rm -rf build && \
    cmake -B build -DCMAKE_BUILD_TYPE=Release && \
    cmake --build build --config Release -j$(nproc)

# 4. Prepare runner
WORKDIR /workspace/zlib-zero
ENV STOCK_LIBZ=/usr/lib/x86_64-linux-gnu/libz.so.1
ENV ZLIB_NG_LIBZ=/workspace/zlib-ng/build/libz.so.1
ENV ZLIB_ZERO_LIBZ=/workspace/zlib-zero/build/libz_zero.so

# Also handle arm64 architecture path if running on Apple Silicon / ARM64
RUN if [ -f /usr/lib/aarch64-linux-gnu/libz.so.1 ]; then \
      echo "export STOCK_LIBZ=/usr/lib/aarch64-linux-gnu/libz.so.1" >> /etc/environment; \
    fi

ENTRYPOINT ["python3", "docker/run_comprehensive_benchmark.py"]
